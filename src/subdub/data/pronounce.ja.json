{
  "_comment": "SAPI日本語音声の読み間違いを補正する辞書。literal は単純置換、regex は正規表現置換(上から順に適用)。自由に追記してください。",

  "regex": [
    ["\\[[^\\]]*\\]", ""],
    ["\\([^)]*音楽[^)]*\\)", ""],
    ["[♪♫]", ""],
    ["^\\s*[-–—]\\s*", ""],
    ["([a-zA-Z])\\s*\\^\\s*2", "\\1の2乗"],
    ["([a-zA-Z])\\s*\\^\\s*3", "\\1の3乗"],
    ["([a-zA-Z])\\s*\\^\\s*n", "\\1のn乗"],
    ["\\bd([a-zA-Z])\\s*/\\s*d([a-zA-Z])\\b", "ディー\\1 ディー\\2"],
    ["\\bf\\s*\\(\\s*x\\s*\\)", "エフエックス"],
    ["\\bg\\s*\\(\\s*x\\s*\\)", "ジーエックス"],
    ["\\s{2,}", " "]
  ],

  "literal": {
    "≈": "およそ",
    "≒": "およそ",
    "→": "から",
    "×": "かける",
    "÷": "わる",
    "±": "プラスマイナス",
    "∞": "無限大",
    "π": "パイ",
    "Δ": "デルタ",
    "δ": "デルタ",
    "ε": "イプシロン",
    "Σ": "シグマ",
    "∫": "インテグラル",
    "√": "ルート",
    "dx": "ディーエックス",
    "dy": "ディーワイ",
    "dt": "ディーティー",
    "微分係数": "びぶんけいすう",
    "導関数": "どうかんすう",
    "原始関数": "げんしかんすう",
    "定積分": "ていせきぶん",
    "不定積分": "ふていせきぶん",
    "接線": "せっせん",
    "傾き": "かたむき",
    "極限": "きょくげん",
    "近似": "きんじ",
    "面積": "めんせき",
    "体積": "たいせき",
    "半径": "はんけい",
    "円周": "えんしゅう",
    "微小": "びしょう"
  }
}
